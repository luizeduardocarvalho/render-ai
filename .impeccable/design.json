{
  "$schema": "impeccable/design",
  "surface": "landing",
  "world": "architecture-monograph",
  "mode": "persuade",
  "colorStrategy": "restrained",
  "themes": {
    "light": {
      "paper": "#efeae1",
      "paper2": "#e7e1d5",
      "ink": "#1a1917",
      "ink2": "#56534b",
      "ink3": "#6f6b5f",
      "rule": "#d0cabb",
      "ruleStrong": "#b6af9d",
      "accent": "#22406b",
      "accentHover": "#2c5187",
      "accentInk": "#f4f1ea"
    },
    "dark": {
      "paper": "#14161a",
      "paper2": "#191c21",
      "ink": "#e8e3d8",
      "ink2": "#a6a294",
      "ink3": "#837f73",
      "rule": "#2b2e34",
      "ruleStrong": "#3b3f47",
      "accent": "#6f9bcd",
      "accentHover": "#8bb0da",
      "accentInk": "#12141a"
    }
  },
  "accentRule": "actionable-only: primary button, links on hover, compare plumb line, spec indices, form focus and caret",
  "type": {
    "display": { "family": "Archivo", "axes": "wght 100-900, wdth 62-125", "use": "expanded+heavy for display and structural labels", "file": "landing/fonts/archivo-var.woff2" },
    "sans": { "family": "Archivo", "use": "body at normal width" },
    "mono": { "family": "Spline Sans Mono", "use": "folios, plate numbers, ledger (tabular-nums), captions, labels, buttons", "file": "landing/fonts/spline-mono-var.woff2" },
    "scale": {
      "heroDisplay": "clamp(40px,6vw,76px)",
      "plateHeading": "clamp(26px,3.4vw,40px)",
      "body": "16-18px @ 62-72ch",
      "monoLabel": "12-14px uppercase +0.1em"
    },
    "emphasis": "weight/size or drawn underline; never color or gradient text"
  },
  "layout": {
    "sheetMax": "1200px",
    "gutter": "clamp(20px,5vw,72px)",
    "corners": { "button": "2px", "plate": "0", "field": "0" },
    "elevation": "none (rules, poche, paper - no decorative shadows)"
  },
  "motion": "one on-load moment: hero rise + rules draw-in, once; disabled under prefers-reduced-motion",
  "browserSurfaces": ["selection", "focus-visible ring", "caret", "scrollbar", "tabular-nums"],
  "syntheticAssets": [
    { "id": "hero-before-after", "kind": "inline-svg", "note": "SketchUp line-art -> schematic photograph stand-in, labeled Fig. 1; replace with real screenshot+render pair" }
  ]
}
