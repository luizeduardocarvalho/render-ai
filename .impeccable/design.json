{
  "$schema": "impeccable/design",
  "surface": "landing",
  "world": "studio3d-identity",
  "mode": "persuade",
  "colorStrategy": "brand-palette-as-structure",
  "authority": "brand/studio3d/README.md (Studio3D brand manual, 2021)",
  "themes": {
    "light": {
      "bg": "#ffffff",
      "ink": "#2a2929",
      "ink2": "#5b5858",
      "ink3": "#6e6a68",
      "rule": "#dadada",
      "link": "#18726e",
      "band": "#2a2929",
      "bandInk": "#ffffff"
    },
    "dark": {
      "bg": "#1e1d1d",
      "ink": "#f3f1f0",
      "ink2": "#c9c5c3",
      "ink3": "#a8a3a0",
      "rule": "#3a3838",
      "link": "#7cc4bd",
      "band": "#2a2929",
      "bandInk": "#ffffff"
    }
  },
  "brand": {
    "black": "#2a2929",
    "orange": "#c25939",
    "teal": "#18726e",
    "red": "#a53b3f",
    "navy": "#263e5a",
    "tints": ["#f6e6e1", "#dfe2e6", "#ddeae9", "#f2e2e2", "#dadada"]
  },
  "colorRules": "orange only at >=30px (4.4:1 on white); brand colors as symbol, texture, 3px separators/ticks, step numbers; never recolor the symbol or wordmark",
  "type": {
    "family": "D-DIN",
    "weights": [400, 700],
    "files": ["landing/fonts/d-din-400.woff2", "landing/fonts/d-din-700.woff2"],
    "license": "SIL OFL 1.1 (landing/fonts/D-DIN-OFL.txt)",
    "tracking": "default (manual: no spacing changes)",
    "scale": {
      "hero": "clamp(40px,5vw,64px) regular, one word bold",
      "section": "clamp(30px,3.6vw,44px) regular",
      "body": "16-20px",
      "label": "13px uppercase +0.08em"
    }
  },
  "layout": {
    "wrapMax": "1200px",
    "gutter": "clamp(16px,5vw,64px)",
    "corners": { "button": "pill", "tag": "pill", "figure": "20px", "field": "12px" },
    "elevation": "none, except the compare grip"
  },
  "motion": "one on-load moment: hero rise, once; disabled under prefers-reduced-motion",
  "brandAssets": {
    "symbol": "scripts/brand-assets/build-symbol.py -> landing/symbol.svg, landing/favicon.svg, inline <symbol id=brand-symbol>",
    "texture": "scripts/brand-assets/build-texture.py -> landing/texture.svg, landing/texture-tint.svg",
    "rasters": "scripts/brand-assets/render.sh -> og-image.png, icons, favicon.ico"
  },
  "syntheticAssets": [
    { "id": "hero-before-after", "kind": "inline-svg", "note": "model line-art -> schematic photograph stand-in; replace with a real screenshot + render pair" }
  ]
}
