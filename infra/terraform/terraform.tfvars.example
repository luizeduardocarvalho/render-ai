# Copy to terraform.tfvars and fill in for your project. terraform.tfvars is
# gitignored (it's local plan input, not shared) - see infra/terraform/README.md
# for how state itself is stored/shared.

app_project_id    = "studioia-app"
vertex_project_id = null               # null runs Vertex AI in app_project_id; set a project id for cross-project Vertex AI
backup_project_id = "studioia-backups" # created by infra/bootstrap

region             = "us-central1"
firestore_location = "nam5"

blob_bucket_name   = "studioia-app-images"
backup_bucket_name = "studioia-backups-blobs"

app_cors_origins = [
  "https://app.studioia.app",     # the app's custom domain (dns.tf)
  "https://studioia-app.web.app", # the `app` Hosting site (.firebaserc targets.studioia-app.hosting.app)
  "http://localhost:5173",
]

github_repository       = "luizeduardocarvalho/render-ai"
github_deploy_reviewers = ["luizeduardocarvalho"] # must approve each production deploy; [] for none

clerk_publishable_key = "REPLACE_ME" # Clerk dashboard -> API keys -> Publishable key (pk_live_...); Terraform rejects anything else

firebase_landing_site_id = "studioia-landing" # .firebaserc target `landing`
firebase_app_site_id     = "studioia-app" # .firebaserc target `app`

domain = "studioia.app" # Cloudflare zone: landing at the apex, the app at app.studioia.app

# Clerk dashboard -> Domains, once the production instance is set to var.domain.
clerk_dns_records = {
  # clerk             = "frontend-api.clerk.services"
  # accounts          = "accounts.clerk.services"
  # clkmail           = "mail.<id>.clerk.services"
  # "clk._domainkey"  = "dkim1.<id>.clerk.services"
  # "clk2._domainkey" = "dkim2.<id>.clerk.services"
}

backup_retention_days = 0 # 0 = no GCS retention policy on the backup bucket (see the variable's description before setting this)

cloud_run_min_instances = 0
cloud_run_max_instances = 4

render_queue_max_concurrent = 4 # Cloud Tasks queue rate_limits.max_concurrent_dispatches for render-jobs
