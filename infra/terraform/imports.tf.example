# Import blocks for what already exists when this config is applied to new
# GCP projects: the GitHub `production` environment, its main-branch
# deployment policy and the Actions variables the workflows read, plus
# Firebase and its default Hosting site. Everything else is created fresh.
#
# Usage: `cp imports.tf.example imports.tf`, `terraform plan` (the resources
# below must show as import, at most with in-place updates), `terraform
# apply`, then delete imports.tf.
#
# The policy id comes from
#   gh api repos/<owner>/<repo>/environments/production/deployment-branch-policies

import {
  to = github_repository_environment.production
  id = "render-ai:production"
}

import {
  to = github_repository_environment_deployment_policy.production_main
  id = "render-ai:production:60922575"
}

import {
  for_each = toset([
    "GCP_WIF_PROVIDER",
    "GCP_DEPLOYER_SA",
    "GCP_ARTIFACT_REPO",
    "GCP_PROJECT",
    "GCP_REGION",
    "VITE_CLERK_PUBLISHABLE_KEY",
  ])
  to = github_actions_environment_variable.deploy[each.key]
  id = "render-ai:production:${each.key}"
}

import {
  for_each = toset([
    "GCP_WIF_PROVIDER",
    "GCP_BACKUP_CHECKER_SA",
    "GCP_APP_PROJECT",
    "GCP_BACKUP_PROJECT",
    "GCP_TRANSFER_JOB",
    "GCP_BACKUP_BUCKET",
    "GCP_FIRESTORE_LOCATION",
    "BACKUP_CHECK_SINCE",
  ])
  to = github_actions_variable.backup_check[each.key]
  id = "render-ai:${each.key}"
}

# Firebase has to be added to a new account's first project in the Firebase
# console (it accepts the Firebase terms, which the API can't), and that
# creates the project's default Hosting site, named after the project - the
# `app` site here.

import {
  to = google_firebase_project.app
  id = "projects/studioia-app"
}

import {
  to = google_firebase_hosting_site.app
  id = "projects/studioia-app/sites/studioia-app"
}
