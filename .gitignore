# OS / editor
.DS_Store

# Firebase local cache
.firebase/

# Env files with real secrets (per-package .env.example stays tracked)
.env
.env.local

# Terraform local state/cache and per-checkout variables (.terraform.lock.hcl
# IS committed - see infra/terraform/README.md)
infra/*/.terraform/
infra/*/*.tfstate
infra/*/*.tfstate.*
infra/*/terraform.tfvars
infra/*/imports.tf

# Studio3D visual identity report (academic thesis, kept local - see brand/studio3d/README.md)
brand/**/*.pdf
