rules_version = '2';

// Firestore security rules for the render-ai landing page contact form.
//
// The public landing page is allowed to CREATE contact messages only, and
// only when they are well-formed. Nobody (client-side) may read, update, or
// delete them - review submissions from the Firebase console or an admin
// backend using the Admin SDK, which bypasses these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /contactMessages/{docId} {
      allow create: if isValidContactMessage();
      allow read, update, delete: if false;
    }

    // App data (projects and their views/renders subcollections) is written and
    // read ONLY by the Go backend via the Firebase Admin SDK, which bypasses
    // these rules entirely. No client ever touches Firestore directly - the
    // frontend goes through the authenticated, ownership-gated HTTP API. So the
    // catch-all below denies all client access to projects/** on purpose; it is
    // the intended posture, not an omission.
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidContactMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'message', 'createdAt'])
        && d.email is string
        && d.email.size() >= 3
        && d.email.size() <= 254
        && d.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && d.message is string
        && d.message.size() >= 1
        && d.message.size() <= 5000
        && d.createdAt == request.time;
    }
  }
}
