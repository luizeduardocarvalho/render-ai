# Clerk publishable key (from https://dashboard.clerk.com) - required for auth to work.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: override the API base URL. Leave unset in production builds - the
# frontend then calls the API same-origin at /api/... (Firebase Hosting
# rewrites this to the Cloud Run backend). In dev, defaults to
# http://localhost:8080 when unset.
VITE_API_URL=
